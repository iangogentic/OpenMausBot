[Unit]
Description=Bounded OpenMaus harness workspaces
Requires=openmaus-storage-preflight.service
After=openmaus-storage-preflight.service
Before=openmaus-storage-prepare.service

[Mount]
What=/var/lib/openmaus-workspaces.btrfs
Where=/var/lib/openmausbot-workspaces
Type=btrfs
Options=loop,nodev,nosuid,noatime

[Install]
WantedBy=multi-user.target
