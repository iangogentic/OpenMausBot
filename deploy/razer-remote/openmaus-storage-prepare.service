[Unit]
Description=Validate and prepare bounded OpenMaus storage
Requires=var-lib-openmaus\x2dprovider-state.mount
Requires=var-lib-openmausbot\x2dworkspaces.mount
Requires=var-lib-openmausbot\x2dvm\x2dhomes.mount
After=var-lib-openmaus\x2dprovider-state.mount
After=var-lib-openmausbot\x2dworkspaces.mount
After=var-lib-openmausbot\x2dvm\x2dhomes.mount
Before=openmausbot.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/openmaus-storage-setup --prepare-mounted
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/openmaus-provider/state /var/lib/openmausbot-workspaces /var/lib/openmausbot-vm-homes
# CAP_FSETID is required when restoring the setgid bit on the workspace
# filesystem root. Without it, chmod(3770) silently lands as 1770 because the
# service is not a member of openmaus-workspace, and the leaf helper correctly
# refuses the drift after a cold boot.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_SYS_ADMIN
AmbientCapabilities=
LockPersonality=yes
RestrictSUIDSGID=no
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
