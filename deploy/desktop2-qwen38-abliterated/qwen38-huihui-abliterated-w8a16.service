[Unit]
Description=Qwen3.8-27B Huihui Abliterated W8A16 on two RTX 3090 GPUs
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/qwen38-huihui-abliterated-w8a16
ExecStart=/usr/bin/docker start qwen38-huihui-abliterated-w8a16
ExecStartPost=/opt/qwen38-huihui-abliterated-w8a16/scripts/wait-ready.sh
ExecStop=/usr/bin/docker stop qwen38-huihui-abliterated-w8a16
TimeoutStartSec=1000
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
